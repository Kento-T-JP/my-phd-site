generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id              Int              @id @default(autoincrement())
  name            String
  position        String[]
  number          Int?
  image           String?
  wikiUrl         String?
  basePlayerId    Int?
  isDeleted       Boolean          @default(false)
  deletedAt       DateTime?
  userId          Int?
  favoritePlayers FavoritePlayer[]
  formationNodes  FormationNode[]
  basePlayer      Player?          @relation("PlayerBase", fields: [basePlayerId], references: [id])
  children        Player[]         @relation("PlayerBase")
  user            User?            @relation(fields: [userId], references: [id])
  rosterPlayers   RosterPlayer[]
  extra           Json?

  @@unique([userId, name])
  @@index([userId, isDeleted, id])
}

model Tournament {
  id      Int      @id @default(autoincrement())
  name    String
  slug    String
  userId  Int
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rosters Roster[]

  @@unique([userId, slug])
  @@index([userId, name])
}

model Roster {
  id           Int            @id @default(autoincrement())
  date         DateTime
  tournamentId Int
  title        String
  endDate      DateTime?
  tournament   Tournament     @relation(fields: [tournamentId], references: [id])
  players      RosterPlayer[]
  userId       Int
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, title])
  @@index([userId, date])
  @@index([tournamentId, userId])
}

model RosterPlayer {
  rosterId Int
  playerId Int
  number   Int?
  position String[]
  player   Player   @relation(fields: [playerId], references: [id])
  roster   Roster   @relation(fields: [rosterId], references: [id])

  @@unique([rosterId, playerId])
  @@index([playerId])
  @@index([rosterId])
}

model User {
  id                 Int                      @id @default(autoincrement())
  name               String?
  email              String                   @unique
  emailVerified      DateTime?
  image              String?
  hashedPassword     String?
  createdAt          DateTime                 @default(now())
  isAdmin            Boolean                  @default(false)
  status             String                   @default("pending")
  googleEmailConsent Boolean                  @default(false)
  termsAcceptedAt    DateTime?
  privacyAcceptedAt  DateTime?
  legalVersionAccepted String?
  verificationTokens EmailVerificationToken[]
  favoritePlayers    FavoritePlayer[]
  formations         Formation[]
  formationCollaborations FormationCollaborator[]
  formationEditSessions FormationEditSession[]
  formationShares    FormationShare[]
  positions          UserPosition[]
  players            Player[]
  rosters            Roster[]
  tournaments        Tournament[]
  accounts           Account[]
  sessions           Session[]
}

model UserPosition {
  id             Int      @id @default(autoincrement())
  name           String
  normalizedName String
  userId         Int
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, normalizedName])
  @@index([userId, name])
}

model FormationShare {
  id          Int      @id @default(autoincrement())
  token       String   @unique
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  formationId Int
  payload     Json
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([token, expiresAt])
  @@index([userId, createdAt])
}

model Account {
  id                 String  @id @default(cuid())
  userId             Int
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Formation {
  id        Int             @id @default(autoincrement())
  userId    Int
  name      String
  positions Json
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id])
  collaborators FormationCollaborator[]
  editSessions  FormationEditSession[]
  nodes     FormationNode[]

  @@index([userId, updatedAt])
}

model FormationCollaborator {
  formationId Int
  userId      Int
  createdAt   DateTime  @default(now())
  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([formationId, userId])
  @@index([userId, createdAt])
}

model FormationEditSession {
  formationId Int
  userId      Int
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([formationId, userId])
  @@index([formationId, lastSeenAt])
  @@index([userId, lastSeenAt])
}

model FormationNode {
  id          Int       @id @default(autoincrement())
  x           Float
  y           Float
  playerId    Int
  formationId Int
  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  player      Player    @relation(fields: [playerId], references: [id])
}

model FavoritePlayer {
  userId   Int
  playerId Int
  player   Player @relation(fields: [playerId], references: [id])
  user     User   @relation(fields: [userId], references: [id])

  @@unique([userId, playerId])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  category  String?
  message   String
  createdAt DateTime @default(now())
  ip        String?
  userAgent String?
  status    String   @default("received")

  @@index([createdAt])
}

model EmailVerificationToken {
  token   String   @id
  userId  Int
  expires DateTime
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PendingRegistration {
  id             Int      @id @default(autoincrement())
  email          String   @unique
  hashedPassword String
  token          String   @unique
  expires        DateTime
  termsAcceptedAt DateTime
  privacyAcceptedAt DateTime
  legalVersionAccepted String
  createdAt      DateTime @default(now())
}

model Visit {
  id        Int      @id @default(autoincrement())
  path      String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([ip])
}
