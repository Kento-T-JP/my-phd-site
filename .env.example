# Core
DATABASE_URL=postgresql://user:password@localhost:5432/dbname?schema=public
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_long_random_secret

# Admin credentials login
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_strong_password

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Captcha
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET=your_recaptcha_secret
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Mail (contact + verification)
GMAIL_USER=your_gmail_address@example.com
GMAIL_APP_PASSWORD=your_gmail_app_password
CONTACT_RECIPIENT=owner@example.com
RESEND_API_KEY=your_resend_api_key
CONFIRM_FROM_ADDRESS=no-reply@example.com

# Access gate (optional)
GATE_ENABLED=true
GATE_ALLOWED_EMAILS=foo@example.com,bar@example.com

# Seed script (optional)
JFA_MEMBER_URL=https://www.jfa.jp/samuraiblue/member.html

ABLY_API_KEY=your_ably_api_key
