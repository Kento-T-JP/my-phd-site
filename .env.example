# Example environment variables
# Copy this file to `.env` and update the values for your setup.

# Connection string for your Postgres database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mydb?schema=public"

# JFA Samurai Blue member list used by the seed script
JFA_MEMBER_URL=https://www.jfa.jp/samuraiblue/member.html

# SMTP configuration for contact emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=username
SMTP_PASS=password

# Recipient for contact emails
CONTACT_RECIPIENT=recipient@example.com
